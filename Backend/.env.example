# Copy this file to .env and fill in your real values.
# .env should NEVER be committed to git (see .gitignore).

PORT=3000

# PostgreSQL 17 connection - check pgAdmin > right-click PostgreSQL 17 > Properties > Connection tab for the port
DB_USER=postgres
DB_HOST=localhost
DB_NAME=transitops_db
DB_PASSWORD=your_postgres17_password_here
DB_PORT=5432

# Use a long random string in real deployments. This is just a placeholder.
JWT_SECRET=change_this_to_a_long_random_secret
